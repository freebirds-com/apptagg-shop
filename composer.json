{
    "name": "freebirds/apptagg-shop",
    "description": "Sell a Laravel shop's products in the Apptagg app: product sync, order import and status updates through the Apptagg Shop API.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["apptagg", "laravel", "marketplace"],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Freebirds\\ApptaggShop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Freebirds\\ApptaggShop\\ApptaggShopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
